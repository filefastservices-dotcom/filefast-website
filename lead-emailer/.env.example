# Copy to .env. Never commit real secrets.
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=filefast
MONGODB_COLLECTION=leads
MONGODB_MAX_POOL_SIZE=10

# smtp or sendgrid
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# For production SMTP use port 465 (implicit TLS) or 587 (STARTTLS).
# SMTP_PORT=587
SENDGRID_API_KEY=
FROM_EMAIL=no-reply@example.com
FROM_NAME=FileFast Global
UNSUBSCRIBE_BASE_URL=http://localhost:8080/unsubscribe
UNSUBSCRIBE_SECRET=replace-with-a-long-random-secret-at-least-32-characters

BATCH_SIZE=25
MAX_PER_MINUTE=30
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1000
POLL_INTERVAL_MS=300000
MAX_LEAD_AGE_DAYS=30
DRY_RUN=false
HEALTH_PORT=8080
# Optional: integration tests only. Use a disposable local test database.
MONGODB_TEST_URI=mongodb://localhost:27017/filefast_emailer_test
