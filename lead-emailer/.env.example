# Copy to .env and replace placeholders. Never commit real credentials.
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=filefast
MONGODB_COLLECTION=leads
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=local
SMTP_PASS=local
SENDGRID_API_KEY=
FROM_EMAIL=no-reply@example.com
FROM_NAME=FileFast Global
UNSUBSCRIBE_BASE_URL=http://localhost:8080/unsubscribe
HMAC_SECRET=replace-with-a-random-secret-at-least-32-characters
BATCH_SIZE=25
MAX_PER_MINUTE=30
MAX_RETRIES=3
MONGODB_MAX_POOL_SIZE=10
PORT=8080
DRY_RUN=false
# Optional incident webhook. Set via secret manager; not required by app.
SLACK_WEBHOOK_URL=
