{
  "name": "filefast-lead-emailer",
  "version": "1.0.0",
  "private": true,
  "description": "Idempotent MongoDB lead email notification worker for FileFast Global",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js --cron",
    "once": "node src/index.js --once",
    "dry-run": "node src/index.js --once --dry-run",
    "resend": "node scripts/resend.js",
    "lint": "eslint src scripts tests",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integration.test.js",
    "check": "npm run lint && npm test"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@sendgrid/mail": "^8.1.4",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "handlebars": "^4.7.8",
    "mongodb": "^6.13.0",
    "nodemailer": "^6.10.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "eslint": "^9.20.1",
    "smtp-server": "^3.13.6"
  }
}
